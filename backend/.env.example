# ── Vision (REQUIRED) ──────────────────────────────────────────────────────────
# Gemini API — FREE, no card needed: https://aistudio.google.com/ → Get API Key
# Free tier: 1,500 requests/day, 15 req/min — more than enough
GEMINI_API_KEY=your_gemini_api_key_here

# Map tiles (OpenStreetMap + Esri) and geocoding (Nominatim) are FREE — no key needed.
# GOOGLE_MAPS_API_KEY is NOT required — the app uses Leaflet + Esri World Imagery instead.
# ───────────────────────────────────────────────────────────────────────────────

# LLM
GROQ_API_KEY=your_groq_api_key_here

# Vector Store
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENV=us-east-1

# Blockchain
# Polygon Amoy testnet (free) — get test MATIC: https://faucet.polygon.technology/
ALCHEMY_RPC_URL=https://rpc-amoy.polygon.technology
# For Polygon MAINNET (real money, ~$0.001/tx): use your Alchemy mainnet URL
# ALCHEMY_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/your_key_here



DEPLOYER_PRIVATE_KEY=your_wallet_private_key_without_0x_prefix
CONTRACT_ADDRESS=0x_deployed_contract_address_here

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/carbon_registry
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=carbon_registry

# Redis
REDIS_URL=redis://redis:6379/0

# App
SECRET_KEY=your_random_secret_key_at_least_32_chars
ENVIRONMENT=development
UPLOAD_DIR=/app/uploads
